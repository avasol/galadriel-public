# === The brain — which key you carry decides who is on the wire ===
# AGENT_PROVIDER selects how your agent thinks. The mind (soul + memory) is the
# same on every path; only the brain power changes. Every path below is direct:
# your machine talks to the provider with YOUR key, and nobody else is on the wire.
#
#   anthropic  (default) — Claude. Set ANTHROPIC_API_KEY.
#   gemini               — Google Gemini. Set GEMINI_API_KEY (or GOOGLE_API_KEY).
#   openai               — OpenAI. Set OPENAI_API_KEY. Also speaks to any
#                          OpenAI-compatible server via OPENAI_BASE_URL.
#   mistral              — Mistral (EU, Paris). Set MISTRAL_API_KEY.
#   nebius               — Nebius AI Studio (EU, Finland): DeepSeek, Qwen, Llama
#                          and others. Set NEBIUS_API_KEY.
#   xai                  — xAI Grok. Set XAI_API_KEY.
#   berget               — Berget AI (EU, Sweden): Gemma, Kimi, GLM, Qwen and
#                          others. Set BERGET_API_KEY.
#   bedrock-nova         — Amazon Nova on Bedrock. Uses the host's AWS
#                          credentials (role or env); no key here.
#   local                — keyless, offline: Ollama / LM Studio / vLLM on your
#                          own machine. Set LOCAL_MODEL.
#
# AGENT_MODEL (below) is the model the agent asks for; /model in Discord sets it
# for you. Each provider also has its own default model variable: GEMINI_MODEL,
# OPENAI_MODEL, MISTRAL_MODEL, NEBIUS_MODEL, XAI_MODEL, BERGET_MODEL, BEDROCK_MODEL_ID,
# LOCAL_MODEL. On a non-Claude brain a Claude AGENT_MODEL is ignored and the brain's
# own default is used, so the line below is safe to leave as it is.
AGENT_PROVIDER=anthropic

# === Claude key (for AGENT_PROVIDER=anthropic — the default) ===
ANTHROPIC_API_KEY=sk-ant-...

# === Gemini one-key path (only for AGENT_PROVIDER=gemini) — LIVE ===
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview
# 2.5 models "think" by default and burn the output budget on hidden reasoning.
# 0 disables it (fast/cheap, default); -1 lets the model decide.
# GEMINI_THINKING_BUDGET=0

# === OpenAI path (only for AGENT_PROVIDER=openai) — LIVE ===
# OPENAI_API_KEY=
# OPENAI_MODEL=                    # any chat-capable id; /model lists what your key sees
# OPENAI_BASE_URL=                  # leave empty for api.openai.com; set for Groq/OpenRouter/DeepSeek/vLLM
# Note: on the reasoning families (gpt-5.x, gpt-6, o-series) chat.completions
# cannot reason AND call tools in one request — tool turns run with
# reasoning_effort=none; tool-less turns translate the thinking budget to
# low/medium/high. Reasoning+tools needs the Responses API (not yet wired).

# === Local / offline path (only for AGENT_PROVIDER=local) — LIVE ===
# LOCAL_MODEL=llama3.1              # the tag your server hosts (REQUIRED)
# LOCAL_BASE_URL=http://localhost:11434/v1   # Ollama default; LM Studio: http://localhost:1234/v1

# === Other brains ===

DISCORD_BOT_TOKEN=your-discord-bot-token

# === Discord Config ===
# Your own Discord user ID (right-click your name → Copy User ID with Developer Mode on)
DISCORD_AUTHORIZED_USER_ID=your-discord-user-id
DISCORD_CHANNEL_ID=your-channel-id

# === Tower UI ===
# SECURITY: Bind to 127.0.0.1 (localhost only) unless you have authentication in front of it.
# The Tower UI has no built-in auth — if bound to 0.0.0.0 on a public server, anyone
# who can reach the port can talk to your agent. Use an SSH tunnel or reverse proxy with auth.
TOWER_HOST=127.0.0.1
TOWER_PORT=8080
# The Tower answers only to the names it is served under (127.0.0.1, localhost, ::1,
# and TOWER_HOST unless it is 0.0.0.0), and refuses changes a browser marks as coming
# from another website. If you reach it by another name (a LAN name, a tunnel IP,
# a peer body knocking over a tunnel), list it here, comma-separated:
# TOWER_ALLOWED_HOSTS=my-box.lan,10.8.0.2
# Change this to a long random string in production
TOWER_SECRET_KEY=change-me-to-something-random

# === AWS (optional - uses instance role if on EC2) ===
AWS_REGION=eu-north-1
# Leave AWS_PROFILE blank when using an EC2 instance role — setting it breaks the AWS CLI
AWS_PROFILE=

# === Agent Behavior ===
# The model. The default below is a Claude model, to match the default provider;
# pick by cost vs. capability. Model names and prices change often, so check
# Anthropic's current model list rather than trusting a list written here.
# Use /model in Discord to see what your key can reach.
#
# Prompt caching is always active. On a warm cache the stable system prompt (SOUL.md,
# MEMORY.md, identity files) is read at a fraction of normal input cost, which cuts
# per-call spend for context-heavy agents. Use /status in Discord to see live numbers.
AGENT_MODEL=claude-sonnet-5

# Max output tokens per API call. 8192 is a good balance:
#   - Low enough to keep per-call output cost reasonable
#   - High enough that the max_tokens retry path rarely triggers
AGENT_MAX_TOKENS=8192

# === Memory Palace (MemPalace) — all optional ===
# The harness loads mempalace lazily; if it's not installed, palace tools
# return [palace unavailable] and everything else runs normally. To enable:
#   pip install -r requirements.txt  (includes mempalace>=3.3.2,<3.4)
#   cp mempalace.yaml.example mempalace.yaml
#   mempalace init                   (creates ~/.mempalace/)
#   mempalace mine .                 (seeds the palace from your repo)
#
# Palace directory — read by the MemPalace library itself (not the harness).
# See https://github.com/MemPalace/mempalace for the library's own docs.
# MEMPALACE_PATH=~/.mempalace/palace
#
# Where archived conversations + pre-compaction tool_results land before
# being mined into the palace.
# PALACE_ARCHIVE_ROOT=~/.mempalace/archive
#
# Cached wake-up snapshot file — regenerated after each mine.
# PALACE_WAKE_UP_FILE=~/.mempalace/wake_up.md
#
# Set to 0 to disable injection of the wake-up snapshot into the dynamic
# system-prompt block. Recovers a small per-call token overhead if budget
# is tight. Default: 1 (enabled).
# PALACE_WAKE_UP_INJECT=1
#
# Ambient reflection (the silent workday-cadence "thinking" loop that files to
# the palace). Set to 0 to disable it entirely — recommended if your model tier
# is expensive and you don't want extra automated turns. Default: 1 (enabled).
# GALADRIEL_REFLECTION=1
